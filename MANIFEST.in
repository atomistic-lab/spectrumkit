graft src

include *.rst
include LICENSE
include CITATION.cff

prune .tox
prune developer
prune docs
prune examples
prune tests
prune .github

exclude .gitattributes
exclude .gitignore
exclude .readthedocs.yml
exclude .codecov.yml
exclude tox.ini

global-exclude *.py[cod] __pycache__/* *.so *.dylib
